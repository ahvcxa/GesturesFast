{
    "manifest_version": 3,
    "name": "GesturesFast",
    "version": "1.0.0",
    "description": "Fast, customizable mouse gesture navigation for your browser.",
    "permissions": [
        "tabs",
        "storage",
        "sessions"
    ],
    "action": {},
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}