{
    "manifest_version": 3,
    "name": "ProjectMaker Gesture Control",
    "version": "1.0.0",
    "description": "Tarayıcınızı fare hareketleriyle (gestures) kontrol edin.",
    "permissions": [
        "tabs",
        "storage",
        "scripting",
        "activeTab"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "ProjectMaker Gestures",
        "default_popup": "popup.html"
    }
}